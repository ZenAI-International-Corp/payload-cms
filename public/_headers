# ========================================
# Static Assets - Immutable cache (versioned resources)
# ========================================
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Next.js Image Optimization
/_next/image*
  Cache-Control: public,max-age=3600,s-maxage=31536000,stale-while-revalidate=86400

# ========================================
# Collection APIs - Handled by middleware (these are fallbacks)
# ========================================

# Products API (1 min browser, 7 days CDN with auto-purge)
/api/products*
  Cache-Control: public,max-age=60,s-maxage=604800,stale-while-revalidate=86400
  Vary: Accept-Encoding

# Categories API (1 min browser, 30 days CDN with auto-purge)
/api/categories*
  Cache-Control: public,max-age=60,s-maxage=2592000,stale-while-revalidate=86400
  Vary: Accept-Encoding

# Media API (1 min browser, 30 days CDN)
/api/media*
  Cache-Control: public,max-age=60,s-maxage=2592000,stale-while-revalidate=86400
  Vary: Accept-Encoding

# ========================================
# Admin Pages - Short cache for static UI
# ========================================
/admin/*
  Cache-Control: private,max-age=60,s-maxage=300,must-revalidate

# ========================================
# GraphQL - Handled by middleware based on authentication
# ========================================
/api/graphql*
  Cache-Control: public,max-age=60,s-maxage=604800,stale-while-revalidate=86400

# ========================================
# Frontend Pages - Handled by middleware (these are fallbacks)
# ========================================

# Product Pages (2 min browser, 7 days CDN with auto-purge)
/products/*
  Cache-Control: public,max-age=120,s-maxage=604800,stale-while-revalidate=86400
  Vary: Accept-Encoding

# Home Page (2 min browser, 7 days CDN)
/
  Cache-Control: public,max-age=120,s-maxage=604800,stale-while-revalidate=86400
  Vary: Accept-Encoding

# ========================================
# Public Assets - Long-term cache
# ========================================
/images/*
  Cache-Control: public,max-age=3600,s-maxage=31536000,stale-while-revalidate=86400

/*.ico
  Cache-Control: public,max-age=31536000,immutable

/*.png
  Cache-Control: public,max-age=3600,s-maxage=31536000

/*.jpg
  Cache-Control: public,max-age=3600,s-maxage=31536000

/*.jpeg
  Cache-Control: public,max-age=3600,s-maxage=31536000

/*.webp
  Cache-Control: public,max-age=3600,s-maxage=31536000

/*.svg
  Cache-Control: public,max-age=3600,s-maxage=31536000

/*.woff
  Cache-Control: public,max-age=31536000,immutable

/*.woff2
  Cache-Control: public,max-age=31536000,immutable