# ========================================
# 静态资源 - 永久缓存（带版本号的资源）
# ========================================
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Next.js 图片优化
/_next/image*
  Cache-Control: public,max-age=86400,s-maxage=31536000,stale-while-revalidate=86400

# ========================================
# 前端 API - 缓存读取操作
# ========================================

# 产品列表 API（缓存 5 分钟）
/api/products*
  Cache-Control: public,max-age=300,s-maxage=3600,stale-while-revalidate=600
  Vary: Accept-Encoding

# 分类 API（缓存 10 分钟）
/api/categories*
  Cache-Control: public,max-age=600,s-maxage=7200,stale-while-revalidate=1200
  Vary: Accept-Encoding

# 媒体/上传资源（缓存 1 小时）
/api/media*
  Cache-Control: public,max-age=3600,s-maxage=86400,stale-while-revalidate=7200
  Vary: Accept-Encoding

# ========================================
# Admin API - 禁止缓存
# ========================================
/admin/*
  Cache-Control: private,no-cache,no-store,must-revalidate
  Pragma: no-cache
  Expires: 0

/api/admin*
  Cache-Control: private,no-cache,no-store,must-revalidate
  Pragma: no-cache
  Expires: 0

# GraphQL - 禁止缓存（除非你需要缓存特定查询）
/api/graphql*
  Cache-Control: private,no-cache,no-store,must-revalidate

# ========================================
# 前端页面 - 适度缓存
# ========================================

# 产品页面（缓存 5 分钟）
/products/*
  Cache-Control: public,max-age=300,s-maxage=3600,stale-while-revalidate=600
  Vary: Accept-Encoding

# 首页（缓存 5 分钟）
/
  Cache-Control: public,max-age=300,s-maxage=3600,stale-while-revalidate=600
  Vary: Accept-Encoding

# ========================================
# 公共资源
# ========================================
/images/*
  Cache-Control: public,max-age=86400,s-maxage=31536000,stale-while-revalidate=86400

/*.ico
  Cache-Control: public,max-age=86400,immutable

/*.png
  Cache-Control: public,max-age=86400,s-maxage=31536000

/*.jpg
  Cache-Control: public,max-age=86400,s-maxage=31536000

/*.jpeg
  Cache-Control: public,max-age=86400,s-maxage=31536000

/*.webp
  Cache-Control: public,max-age=86400,s-maxage=31536000

/*.svg
  Cache-Control: public,max-age=86400,s-maxage=31536000

/*.woff
  Cache-Control: public,max-age=31536000,immutable

/*.woff2
  Cache-Control: public,max-age=31536000,immutable